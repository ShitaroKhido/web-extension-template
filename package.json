{
  "name": "web-extension-template",
  "version": "1.0.0",
  "description": "This is a template for creating Chrome extensions using Vite and Manifest V3.",
  "main": "vite.config.js",
  "scripts": {
    "dev:chrome": "TARGET=chrome vite",
    "dev:firefox": "TARGET=firefox vite",
    "build:chrome": "TARGET=chrome vite build",
    "build:firefox": "TARGET=firefox vite build",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "build:zip": "npm run build:all && node scripts/zip-builds.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShitaroKhido/web-extension-template.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ShitaroKhido/web-extension-template/issues"
  },
  "homepage": "https://github.com/ShitaroKhido/web-extension-template#readme",
  "devDependencies": {
    "archiver": "^7.0.1",
    "vite": "^7.2.4",
    "vite-plugin-web-extension": "^4.5.0",
    "webextension-polyfill": "^0.12.0"
  }
}
