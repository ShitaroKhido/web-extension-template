{
    "manifest_version": 3,
    "name": "My Minimal Extension",
    "version": "1.0.0",
    "description": "A minimal, lightweight cross-browser extension template",
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "My Extension",
        "default_icon": {
            "16": "icons/icon-16.svg",
            "48": "icons/icon-48.svg",
            "128": "icons/icon-128.svg"
        }
    },
    "icons": {
        "16": "icons/icon-16.svg",
        "48": "icons/icon-48.svg",
        "128": "icons/icon-128.svg"
    },
    "permissions": [
        "storage",
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "content-script.js"
            ]
        }
    ]
}