# Environment variables for the extension

# Extension Metadata
VITE_APP_NAME=Your Extension Name
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Description of your Chrome extension.

# Permissions
VITE_PERMISSIONS=storage,tabs
VITE_HOST_PERMISSIONS=<all_urls> 

# Content script match patterns (used in manifest.json)
VITE_CONTENT_SCRIPT_MATCHES=<all_urls>

# Firefox Specific
VITE_FIREFOX_ADDON_ID=addon@example.com
